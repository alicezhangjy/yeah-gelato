{
  "name": "telegram-to-sheets",
  "version": "1.0.0",
  "description": "A TypeScript project that pulls data from Telegram channels and adds filtered data to Google Sheets",
  "main": "dist/gelato-server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run start:server",
    "start:server": "node dist/gelato-server.js",
    "dev": "ts-node --esm src/gelato-index.ts",
    "dev:server": "ts-node --esm src/gelato-server.ts",
    "watch": "nodemon --exec ts-node --esm src/gelato-index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:telegram": "node scripts/test-telegram.js",
    "fill-dates": "node scripts/test-date-filling.js",
    "status": "npm run build && node dist/gelato-index.js status"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "telegram",
    "google-sheets",
    "typescript",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "@types/node-telegram-bot-api": "^0.64.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^164.1.0",
    "telegraf": "^4.16.3"
  }
}
