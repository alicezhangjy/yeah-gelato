# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username_or_-chat_id

# Google Sheets Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=TelegramData
GOOGLE_SHEETS_AUTO_FORMAT=true

# Google Service Account Credentials (JSON format)
# You can get this from Google Cloud Console
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id",...}

# Alternative: Path to credentials file (not recommended for production)
# GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json

# Application Configuration
LOG_LEVEL=INFO
BATCH_PROCESSING=true
BATCH_SIZE=10
BATCH_TIMEOUT=30000
PROCESS_HISTORICAL_MESSAGES=false
HISTORICAL_MESSAGE_LIMIT=100